{
 "accounts.archived": {
  "additionalProperties": false,
  "description": "`accounts.created` / `.updated` / `.archived`. `archived` also lists what was removed.",
  "properties": {
   "changes": {
    "items": {
     "additionalProperties": false,
     "description": "One changed field; values are strings, absent when empty. Scalars as their string form (money as\ndecimal strings); object values (e.g. a drawdown) as compact JSON with sorted keys and string\namounts, e.g. `{\"amount\":\"2000.00\",\"type\":\"static\"}`.\n",
     "properties": {
      "field": {
       "maxLength": 64,
       "pattern": "^[a-z][a-z0-9_.]*$",
       "type": "string"
      },
      "new": {
       "maxLength": 1000,
       "type": "string"
      },
      "old": {
       "maxLength": 1000,
       "type": "string"
      }
     },
     "required": [
      "field"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "removed_follower_links": {
    "items": {
     "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
     "type": "string"
    },
    "type": "array"
   },
   "removed_routes": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "source_id": {
       "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
       "type": "string"
      },
      "source_name": {
       "maxLength": 60,
       "minLength": 1,
       "type": "string"
      }
     },
     "required": [
      "source_id",
      "source_name"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "changes"
  ],
  "type": "object"
 },
