 "accounts.evaluation_restarted": {
  "additionalProperties": false,
  "properties": {
   "earned_before": {
    "pattern": "^-?[0-9]{1,14}(\\.[0-9]{1,4})?$",
    "type": "string"
   },
   "previous_earned_before": {
    "pattern": "^-?[0-9]{1,14}(\\.[0-9]{1,4})?$",
    "type": "string"
   },
   "previous_start": {
    "format": "date",
    "type": "string"
   },
   "profit_target": {
    "pattern": "^-?[0-9]{1,14}(\\.[0-9]{1,4})?$",
    "type": "string"
   },
   "start": {
    "format": "date",
    "type": "string"
   }
  },
  "required": [
   "start",
   "previous_start",
   "profit_target"
  ],
  "type": "object"
 },
 "accounts.lifecycle_changed": {
  "additionalProperties": false,
  "properties": {
   "had_open_position": {
    "type": "boolean"
   },
   "new_state": {
    "enum": [
     "active",
     "paused",
     "disabled"
    ],
    "type": "string"
   },
   "previous_state": {
    "enum": [
     "active",
     "paused",
     "disabled"
    ],
    "type": "string"
   }
  },
  "required": [
   "previous_state",
   "new_state",
   "had_open_position"
  ],
  "type": "object"
 },
 "accounts.opt_in_chosen": {
  "additionalProperties": false,
  "description": "S5 AC-8: the choice and the exact rule text version the user saw.",
  "properties": {
   "choice": {
    "enum": [
     "accepted",
     "declined"
    ],
    "type": "string"
   },
   "firm_name": {
    "maxLength": 120,
    "type": "string"
   },
   "firm_stance": {
    "description": "Stance of the rule version for the opt-in kind. A missing stance in the preset, and every prop account without a preset (generic rule, Q40), is `unknown`.",
    "enum": [
     "allowed",
     "forbidden",
     "conditional",
     "unknown",
     "not_confirmed"
    ],
    "type": "string"
   },
   "kind": {
    "enum": [
     "automation",
     "copy"
    ],
    "type": "string"
   },
   "previous_choice": {
    "enum": [
     "accepted",
     "declined"
    ],
    "type": "string"
   },
   "rule_version_id": {
    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
    "type": "string"
   },
   "rule_version_number": {
    "minimum": 1,
    "type": "integer"
   },
   "sources": {
    "description": "URL and access date of each quote shown (empty for the generic rule).",
    "items": {
     "additionalProperties": false,
     "properties": {
      "accessed_at": {
       "format": "date",
       "type": "string"
      },
      "url": {
       "format": "uri",
       "maxLength": 2048,
       "pattern": "^https://",
       "type": "string"
      }
     },
     "required": [
      "url",
      "accessed_at"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "kind",
   "choice",
   "rule_version_id",
   "firm_stance",
   "sources"
  ],
  "type": "object"
 },
 "accounts.opt_in_suspended": {
  "additionalProperties": false,
  "properties": {
   "cause": {
    "enum": [
     "stance_changed",
     "text_changed",
     "preset_attached"
    ],
    "type": "string"
   },
   "firm_name": {
    "maxLength": 120,
    "type": "string"
   },
   "kind": {
    "enum": [
     "automation",
     "copy"
    ],
    "type": "string"
   },
   "previous_rule_version_id": {
    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
    "type": "string"
   },
   "rule_version_id": {
    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
    "type": "string"
   },
   "rule_version_number": {
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "kind",
   "cause",
   "rule_version_id"
  ],
  "type": "object"
 },
