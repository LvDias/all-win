# Copy to infra/compose/.env (never committed). Dev/simulation values only.
# Use URL-safe characters (letters, digits, - _ .) in passwords: they go into postgres:// URLs unencoded.
# Role passwords apply on FIRST start of an empty data volume; after changing them run
#   infra/scripts/dev-stack.sh down && docker volume rm allwin-dev_pgdata
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-superuser-dev-only
ALLWIN_OWNER_PASSWORD=change-me-owner-dev-only
ALLWIN_APP_PASSWORD=change-me-app-dev-only
ALLWIN_WORKER_PASSWORD=change-me-worker-dev-only
ALLWIN_MAINT_PASSWORD=change-me-maint-dev-only
POSTGRES_HOST_PORT=5433
CORE_PORT=8080
CADDY_HTTPS_PORT=8443
RUST_LOG=info
# INFO (default) or DEBUG for the Caddy server/error loggers
CADDY_LOG_LEVEL=INFO
