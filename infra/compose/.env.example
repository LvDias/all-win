# Copy to infra/compose/.env (never committed). Dev/simulation values only.
# Use URL-safe characters (letters, digits, - _ .) in passwords: they go into postgres:// URLs unencoded.
# Role passwords apply on FIRST start of an empty data volume; after changing them run
#   infra/scripts/dev-stack.sh down && docker volume rm allwin-dev_pgdata
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-superuser-dev-only
ALLWIN_OWNER_PASSWORD=change-me-owner-dev-only
ALLWIN_APP_PASSWORD=change-me-app-dev-only
ALLWIN_WORKER_PASSWORD=change-me-worker-dev-only
ALLWIN_MAINT_PASSWORD=change-me-maint-dev-only
POSTGRES_HOST_PORT=5433
CORE_PORT=8080
CADDY_HTTPS_PORT=8443
RUST_LOG=info
# INFO (default) or DEBUG for the Caddy server/error loggers
CADDY_LOG_LEVEL=INFO

# ---- Sunday stack overlay (docker-compose.stack.yml) ----
# Server pepper(s) for the identity codes and tokens: VERSION:BASE64URL, at least 32 random bytes. Generate with:
#   echo "1:$(openssl rand 32 | base64 | tr '+/' '-_' | tr -d '=')"
IDENTITY_PEPPERS=1:change-me-generate-32-random-bytes-base64url
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025
# Mailpit UI/API basic auth (the host is shared): an htpasswd file on the HOST, mode 600, outside the repository. Create it with:
#   printf 'allwin:%s\n' "$(openssl passwd -apr1 '<password>')" > /path/outside/repo/mailpit-htpasswd && chmod 600 /path/outside/repo/mailpit-htpasswd
ALLWIN_MAILPIT_AUTH_FILE=/path/outside/repo/mailpit-htpasswd
# Only for the sim service: run it as the owner of the device token file.
#   ALLWIN_SIM_UID=$(id -u) ALLWIN_SIM_GID=$(id -g)
