# All Win — Caddy (dev). Contract: docs/architecture/contracts/s1-webhook-ingest.md §4, ADR-0001 §5/§9.
# Masking rule R2: Caddy never records the request URI.
#  - access log: request>uri and request>headers>Referer are deleted for EVERY request
#  - ingress-like requests (case-insensitive, decoded, repeated '/' collapsed, starting /ingress) are also log_skip'd (second layer); the Core logs them
#  - resp_headers>Location is deleted too (a locale redirect would echo the pasted path)
#  - error/debug/reverse_proxy logs: request>uri and request>headers are deleted for every path
#  - log_credentials stays OFF (default): Authorization/Cookie are redacted on any line that still logs headers (/adapter carries Bearer awd_...)
{
	admin off
	auto_https disable_redirects
	# Internal CA for local TLS only; never a public certificate in dev.
	local_certs
	log default {
		# CADDY_LOG_LEVEL=DEBUG enables debug output (M1 coverage); the same URI/header deletion applies.
		level {$CADDY_LOG_LEVEL:INFO}
		output stdout
		format filter {
			wrap json
			fields {
				request>uri delete
				request>headers delete
				resp_headers>Location delete
			}
		}
	}
}

# Dev origin. Host port is published on 127.0.0.1 only (see docker-compose.dev.yml).
https://localhost:{$CADDY_HTTPS_PORT:8443} {
	tls internal

	@ingress_rx path_regexp (?i)^/+ingress
	@ingress_glob path /ingress*
	log_skip @ingress_rx
	log_skip @ingress_glob

	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>uri delete
				request>headers>Referer delete
				resp_headers>Location delete
			}
		}
	}

	# HSTS for the whole origin; CSP, nosniff, Referrer-Policy and Permissions-Policy belong to Next/Core (ADR-0001 §9).
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"

	encode zstd gzip

	# Same matcher as log_skip: every ingress-like path (/ingress, /ingressfoo, //ingress, /INGRESS, /%69ngress) goes to the Core, which answers the empty 404.
	handle @ingress_rx {
		# Hard transport cap, above the 16 KiB contract limit so the Core answers 413.
		request_body {
			max_size 64KB
		}
		reverse_proxy core:{$CORE_PORT:8080}
	}

	handle /api/* {
		reverse_proxy core:{$CORE_PORT:8080}
	}

	# `web` joins here once S3/S4 provide it (same origin, ADR-0001).
	handle {
		respond "All Win dev edge" 200
	}
}
