#!/usr/bin/env bash
# Run a heavy command (cargo build/test/clippy, dotnet build/test, pnpm build, full vitest, playwright, e2e stack)
# under a host-wide 4-slot semaphore (temporarily; 3 normally), a CPU quota and low CPU/IO priority. See infra/scripts/README-heavy.md.
#   allwin-heavy cargo test --workspace
#   allwin-heavy --fresh-target cargo test --workspace   (QA verdict run: private target per SHA, removed after)
#   allwin-heavy --lane sunday cargo build ...          (priority lane; only for worktrees listed in LOCK_DIR/LANE.sunday, set by the Maestro)
#   allwin-heavy --status                                (read-only: running jobs and the queue, in order)
# Jobs enter a FIFO queue of tickets: the oldest live ticket of the highest lane (sunday before normal) takes the next free slot.
# `pnpm install --offline --frozen-lockfile` is not queued: it runs at once with nice 19 and ionice idle.
set -euo pipefail

# 3 slots (the temporary 4-slot setting was withdrawn on 2026-10-24: load 36/27/19, above the ~12 the user set as the condition).
DEFAULT_SLOTS=3   # the 4-slot trial ended: the load stayed above the user's ~12 condition (2026-10-24)
SLOTS="${ALLWIN_HEAVY_SLOTS:-$DEFAULT_SLOTS}"
LOCK_DIR="${ALLWIN_HEAVY_LOCK_DIR:-/srv/www/allwin.worktrees/.heavy-locks}"
CPU_QUOTA="${ALLWIN_HEAVY_CPU_QUOTA:-200%}"
WAIT_MAX="${ALLWIN_HEAVY_WAIT_S:-1800}"   # seconds to wait for a slot

FRESH=0; STATUS=0; LANE="${ALLWIN_HEAVY_LANE:-normal}"
while [ $# -gt 0 ]; do
  case "$1" in
    --fresh-target) FRESH=1; shift ;;
    --lane) LANE="${2:-}"; [ -n "$LANE" ] || { echo "allwin-heavy: --lane needs a name" >&2; exit 2; }; shift 2 ;;
    --status) STATUS=1; shift ;;
    *) break ;;
  esac
done
[ "${ALLWIN_HEAVY_FRESH_TARGET:-0}" = 1 ] && FRESH=1
[[ "$LANE" =~ ^(normal|sunday)$ ]] || { echo "allwin-heavy: lane must be normal or sunday" >&2; exit 2; }

# pnpm install --offline --frozen-lockfile is mostly I/O and not in the heavy list: no queue, no slot, lowest priority.
if [ "$STATUS" = 0 ] && [ "${1:-}" = pnpm ] && [ "${2:-}" = install ]; then
  off=0 froz=0; for a in "$@"; do case "$a" in --offline) off=1 ;; --frozen-lockfile) froz=1 ;; esac; done
  if [ "$off" = 1 ] && [ "$froz" = 1 ]; then
    echo "allwin-heavy: pnpm install --offline --frozen-lockfile runs outside the queue (nice 19, ionice idle)" >&2
    exec nice -n 19 ionice -c3 "$@"
  fi
fi

[ "$STATUS" = 1 ] || [ $# -gt 0 ] || { echo "usage: allwin-heavy [--fresh-target] [--lane sunday] <command> [args...] | --status" >&2; exit 2; }
[[ "$SLOTS" =~ ^[1-9][0-9]?$ ]] || { echo "allwin-heavy: ALLWIN_HEAVY_SLOTS must be 1..99" >&2; exit 2; }

# Shared lock dir for every account in group devs (setgid 2770); lock files are 0660.
( umask 007; mkdir -p -- "$LOCK_DIR" ) 2>/dev/null || true
[ -d "$LOCK_DIR" ] && [ -w "$LOCK_DIR" ] && [ ! -L "$LOCK_DIR" ] \
  || { echo "allwin-heavy: lock dir $LOCK_DIR is missing, a symlink or not writable" >&2; exit 1; }
chmod 2770 -- "$LOCK_DIR" 2>/dev/null || true

QUEUE="$LOCK_DIR/queue"
( umask 007; mkdir -p -- "$QUEUE" ) 2>/dev/null || true

# Live tickets in service order: lane sunday before normal, then by arrival (nanoseconds). A ticket is live while /proc/<pid> exists
# (works across accounts); tickets of dead processes are removed. Prints "<rank><ns> <ticket file>".
queue_live() {
  local f b lane ns user pid rank
  for f in "$QUEUE"/*; do
    [ -e "$f" ] || continue
    b="${f##*/}"; IFS=. read -r lane ns user pid <<<"$b"
    if [[ ! "$pid" =~ ^[0-9]+$ || ! "$ns" =~ ^[0-9]+$ ]]; then rm -f -- "$f" 2>/dev/null; continue; fi
    if [ ! -d "/proc/$pid" ]; then rm -f -- "$f" 2>/dev/null; continue; fi
    case "$lane" in sunday) rank=0 ;; *) rank=1 ;; esac
    printf '%s%s %s\n' "$rank" "$ns" "$f"
  done | sort
}
field() { sed -n "s/^$1=//p" "$2" 2>/dev/null | head -n 1; }   # field <key> <file>

if [ "$STATUS" = 1 ]; then
  now="$(date +%s)"
  echo "slots ($SLOTS), lanes: sunday before normal, then first come first served"
  for i in $(seq 1 "$SLOTS"); do
    info="$LOCK_DIR/slot.$i.info"; pid=""; [ -f "$info" ] && pid="$(field pid "$info")"
    if [ -n "$pid" ] && [ -d "/proc/$pid" ]; then
      printf '  slot.%s  RUNNING  %s  lane %s  %s min  pid %s  %s | %s\n' "$i" "$(field user "$info")" "$(field lane "$info")" \
        "$(( (now - $(field start "$info" || echo "$now")) / 60 ))" "$pid" "$(field cwd "$info")" "$(field cmd "$info")"
    else
      printf '  slot.%s  free or running outside the tickets (no live record)\n' "$i"
    fi
  done
  echo "queue (service order):"
  n=0
  while read -r _ f; do
    n=$((n+1)); t="$(stat -c %Y "$f" 2>/dev/null || echo "$now")"
    printf '  %2s  lane %-6s  %s min  %s  %s | %s\n' "$n" "$(field lane "$f")" "$(( (now - t) / 60 ))" "$(field user "$f")" "$(field cwd "$f")" "$(field cmd "$f")"
  done < <(queue_live)
  [ "$n" -gt 0 ] || echo "  (empty)"
  [ -e "$LOCK_DIR/PAUSE" ] && echo "PAUSE in force: $(head -n 1 "$LOCK_DIR/PAUSE" | head -c 200 | tr -d '\000-\037')"
  exit 0
fi

# Lane check: the sunday lane is only for worktrees listed (one per line) in LOCK_DIR/LANE.sunday. A line is an absolute path prefix, a name
# under /srv/www/allwin.worktrees, or "*/name" (any directory called name). Anyone else asking for it runs in the normal lane.
if [ "$LANE" = sunday ]; then
  cwd_real="$(pwd -P)"; allowed=0
  while IFS= read -r entry; do
    entry="${entry%%#*}"; entry="${entry//[[:space:]]/}"; [ -n "$entry" ] || continue
    case "$entry" in
      \*/*) nm="${entry#*/}"; case "$cwd_real/" in *"/$nm/"*) allowed=1 ;; esac ;;
      /*) pre="${entry%/}" ;;
      *) pre="/srv/www/allwin.worktrees/$entry" ;;
    esac
    case "$entry" in \*/*) ;; *) if [ "$cwd_real" = "$pre" ] || [[ "$cwd_real" == "$pre"/* ]]; then allowed=1; fi ;; esac
    [ "$allowed" = 1 ] && break
  done < <(cat "$LOCK_DIR/LANE.sunday" 2>/dev/null || true)
  if [ "$allowed" != 1 ]; then
    echo "allwin-heavy: lane sunday is not allowed for $cwd_real (not in LANE.sunday); running in the normal lane" >&2; LANE=normal
  fi
fi

# Ticket: written on entry, removed when the job takes a slot or the wrapper dies.
user_safe="$(id -un | tr -c 'a-z0-9_-' '_')"
ticket="$QUEUE/$LANE.$(date +%s%N).$user_safe.$$"
( umask 007; printf 'user=%s\nlane=%s\ncwd=%s\ncmd=%s\n' "$(id -un)" "$LANE" "$(pwd -P)" "$(printf '%s ' "$@" | head -c 120 | tr -d '\000-\037')" > "$ticket" )
trap 'rm -f -- "$ticket"' EXIT
trap 'exit 130' INT TERM
last_pos=0

# Wait for the ticket's turn, then take any free slot. The slot is held by this shell's fd until the command ends
# (the child inherits it too, so the slot stays taken even if this wrapper is killed).
waited=0 announced=0 paused_said=0 stale_said=0 pause_last=0 held=""
while [ -z "$held" ]; do
  # Planned quiet window (SRE perf measurement): while LOCK_DIR/PAUSE is in force, NEW jobs wait; running jobs finish.
  # Waiting under a pause does not count against the wait limit. Only ALLWIN_HEAVY_IGNORE_PAUSE=1 (the measuring
  # account's own run) goes through. A PAUSE expires on its own: it is ignored once the end time in its first line
  # ("until HH:MM") has passed, or once the file is older than 2 hours, so a forgotten one cannot stall the queue.
  if [ -e "$LOCK_DIR/PAUSE" ] && [ "${ALLWIN_HEAVY_IGNORE_PAUSE:-0}" != 1 ]; then
    now="$(date +%s)"; mt="$(stat -c %Y "$LOCK_DIR/PAUSE" 2>/dev/null || echo "$now")"; pause_age=$(( now - mt ))
    pause_note="$(head -n 1 "$LOCK_DIR/PAUSE" 2>/dev/null | head -c 200 | tr -d '\000-\037')"
    pause_owner="$(stat -c %U "$LOCK_DIR/PAUSE" 2>/dev/null || echo '?')"
    pause_expired=0
    [ "$pause_age" -gt 7200 ] && pause_expired=1
    if [[ "$pause_note" =~ until[[:space:]]+([0-2][0-9]):([0-5][0-9]) ]]; then
      pause_end="$(date -d "${BASH_REMATCH[1]}:${BASH_REMATCH[2]}" +%s 2>/dev/null || echo 0)"
      [ "$pause_end" -gt 0 ] && [ "$pause_end" -lt "$mt" ] && pause_end=$(( pause_end + 86400 ))   # end time after midnight
      [ "$pause_end" -gt 0 ] && [ "$now" -gt "$pause_end" ] && pause_expired=1
    fi
    if [ "$pause_expired" = 1 ]; then
      [ "$stale_said" = 1 ] || { echo "allwin-heavy: ignoring an expired PAUSE (owner $pause_owner, age $(( pause_age / 60 )) min${pause_note:+, $pause_note})" >&2; stale_said=1; }
    else
      if [ "$paused_said" = 0 ] || [ $(( now - pause_last )) -ge "${ALLWIN_HEAVY_PAUSE_MSG_S:-300}" ]; then
        echo "allwin-heavy: paused for SRE quiet window (owner $pause_owner, age $(( pause_age / 60 )) min${pause_note:+, $pause_note}); waiting for it to end..." >&2
        paused_said=1; pause_last="$now"
      fi
      sleep 5; continue
    fi
  fi
  # Position in the queue (a vanished ticket is written again).
  [ -e "$ticket" ] || ( umask 007; printf 'user=%s\nlane=%s\ncwd=%s\ncmd=%s\n' "$(id -un)" "$LANE" "$(pwd -P)" "re-queued" > "$ticket" )
  pos=0; total=0
  while read -r _ qf; do total=$((total+1)); [ "$qf" = "$ticket" ] && pos=$total; done < <(queue_live)
  [ "$pos" -ge 1 ] || { sleep 1; continue; }
  if [ "$pos" -eq 1 ]; then
    for i in $(seq 1 "$SLOTS"); do
      f="$LOCK_DIR/slot.$i"
      ( umask 007; : >> "$f" ) 2>/dev/null || true
      exec {fd}>>"$f" || continue
      if flock -n "$fd"; then held="$i"; break; fi
      exec {fd}>&-
    done
    [ -n "$held" ] && break
  fi
  # Waiting. A normal job gives up after WAIT_MAX seconds without progress: the clock restarts whenever its position improves, so exit 75
  # means starved, not unlucky. The sunday lane waits without a limit.
  if [ "$last_pos" -eq 0 ] || [ "$pos" -lt "$last_pos" ]; then waited=0; fi
  if [ "$pos" != "$last_pos" ]; then
    if [ "$pos" -eq 1 ]; then why="next in line, all $SLOTS slots busy"; else why="position $pos of $total"; fi
    if [ "$LANE" = sunday ]; then lim=""; else lim=" (gives up after ${WAIT_MAX}s without progress)"; fi
    echo "allwin-heavy: waiting, lane $LANE, $why$lim" >&2
    last_pos="$pos"
  fi
  if [ "$LANE" != sunday ] && [ "$waited" -ge "$WAIT_MAX" ]; then echo "allwin-heavy: gave up waiting for a slot (starved: ${WAIT_MAX}s without progress)" >&2; exit 75; fi
  sleep 3; waited=$((waited + 3))
done
# The slot is ours: the ticket goes away and a record tells --status what runs here (stale records are recognized by their pid).
rm -f -- "$ticket"
( umask 007; printf 'pid=%s\nuser=%s\nlane=%s\nstart=%s\ncwd=%s\ncmd=%s\n' "$$" "$(id -un)" "$LANE" "$(date +%s)" "$(pwd -P)" \
    "$(printf '%s ' "$@" | head -c 120 | tr -d '\000-\037')" > "$LOCK_DIR/slot.$held.info" ) 2>/dev/null || true

# Defaults that keep the build small; the caller can override any of them.
umask 002   # files created under the shared toolchain and caches stay group-writable (group devs)
export CARGO_BUILD_JOBS="${CARGO_BUILD_JOBS:-2}"
TARGET_ROOT="${ALLWIN_HEAVY_TARGET_ROOT:-$HOME/.cache/allwin/cargo-target}"
# Web Playwright (web/playwright.config.ts reuses any server already listening on PLAYWRIGHT_PORT when not in CI):
# give every worktree its own free port so a run never talks to another worktree's server.
if [ -z "${PLAYWRIGHT_PORT:-}" ]; then
  root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
  base=$(( 3200 + $(printf '%s' "$root" | cksum | cut -d' ' -f1) % 700 ))
  for off in $(seq 0 699); do
    cand=$(( 3200 + (base - 3200 + off) % 700 ))
    if ! ss -ltnH "sport = :$cand" 2>/dev/null | grep -q .; then PLAYWRIGHT_PORT="$cand"; break; fi
  done
  [ -n "${PLAYWRIGHT_PORT:-}" ] || { echo "allwin-heavy: no free port in 3200-3899" >&2; exit 1; }
  export PLAYWRIGHT_PORT
fi
export PLAYWRIGHT_BASE_URL="${PLAYWRIGHT_BASE_URL:-http://localhost:$PLAYWRIGHT_PORT}"
# Same toolchain for every account (rustc 1.99.1 under /opt/rust), so compile-cache keys match across accounts.
if [ -z "${RUSTUP_HOME:-}" ] && [ -d /opt/rust/rustup ]; then
  export RUSTUP_HOME=/opt/rust/rustup CARGO_HOME="${CARGO_HOME:-/opt/rust/cargo}"
  case ":$PATH:" in *":/opt/rust/cargo/bin:"*) ;; *) export PATH="/opt/rust/cargo/bin:$PATH" ;; esac
fi

# Shared compile cache (sccache, group-devs directory). One sccache server PER JOB, on a unix socket inside the
# user's runtime dir: the server runs inside this job's scope (its CPU counts against the job's quota), serves only this
# job, and is stopped when the job ends. Never the default TCP port: a client uses whatever server answers there,
# whichever account started it. Incremental compilation is off because sccache cannot cache it.
# ON by default (verified per job server as dev2 and dev3). ALLWIN_HEAVY_NO_SCCACHE=1 turns it off.
SCCACHE_BIN="${ALLWIN_HEAVY_SCCACHE:-/opt/rust/cargo/bin/sccache}"
SCCACHE_ON=0
unset SCCACHE_NO_DAEMON SCCACHE_SERVER_PORT SCCACHE_START_SERVER
RUNDIR="/run/user/$(id -u)"
if [ "${ALLWIN_HEAVY_NO_SCCACHE:-0}" != 1 ] && [ -x "$SCCACHE_BIN" ] && [ -z "${RUSTC_WRAPPER:-}" ] \
   && [ -d "$RUNDIR" ] && [ -w "$RUNDIR" ]; then
  export SCCACHE_DIR="${SCCACHE_DIR:-/srv/www/allwin.worktrees/.sccache}"
  mkdir -p -- "$SCCACHE_DIR" 2>/dev/null || true
  if [ -d "$SCCACHE_DIR" ] && [ -w "$SCCACHE_DIR" ]; then
    export SCCACHE_CACHE_SIZE="${SCCACHE_CACHE_SIZE:-30G}" CARGO_INCREMENTAL=0 SCCACHE_IDLE_TIMEOUT=0
    export SCCACHE_SERVER_UDS="$RUNDIR/allwin-sccache-$$.sock"   # short path: SUN_LEN limit
    export RUSTC_WRAPPER="$SCCACHE_BIN"
    SCCACHE_ON=1
  fi
fi

SLOT_TARGET=0
if [ "$SCCACHE_ON" = 1 ] && [ -z "${CARGO_TARGET_DIR:-}" ]; then
  # With the compile cache on, the target path is what keys it: use ONE fixed path per (account, slot), identical for every job on that slot,
  # worktree and every job, and empty it when the job starts. The slot gives exclusivity, the empty dir gives a clean
  # build (nothing from another worktree or SHA can mix in), and the cache restores third-party crates by content.
  export CARGO_TARGET_DIR="$TARGET_ROOT/slot-$held"
  SLOT_TARGET=1
elif [ "$FRESH" = 1 ]; then
  # A snapshot of another SHA must never see this one's artifacts (same layout, same metadata hash):
  # verdict runs get a target of their own, named by the commit, and remove it afterwards.
  sha="$(git rev-parse --short=12 HEAD 2>/dev/null || echo nogit)"
  git diff --quiet HEAD 2>/dev/null || sha="$sha-dirty"
  export CARGO_TARGET_DIR="$TARGET_ROOT/verify-$sha-$$"
elif [ -z "${CARGO_TARGET_DIR:-}" ]; then
  # One target per worktree: two worktrees with the same layout give our path crates the same metadata, so a shared
  # target mixes their artifacts (false failures, and a test could pass against another worktree's code).
  wt_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd -P)"
  export CARGO_TARGET_DIR="$TARGET_ROOT/wt-$(printf '%s' "${wt_root##*/}" | tr -c 'A-Za-z0-9._-' '_' | cut -c1-40)-$(printf '%s' "$wt_root" | sha1sum | cut -c1-10)"
fi
mkdir -p -- "$CARGO_TARGET_DIR"
if [ "$SLOT_TARGET" = 1 ]; then
  case "$CARGO_TARGET_DIR" in "$TARGET_ROOT"/slot-[0-9]*) find "$CARGO_TARGET_DIR" -mindepth 1 -maxdepth 1 -exec rm -rf -- {} + ;; esac
fi

# dotnet: no resident MSBuild nodes or build servers holding memory (and the slot) after the command.
export UseSharedCompilation=false MSBUILDDISABLENODEREUSE=1 DOTNET_CLI_TELEMETRY_OPTOUT=1 DOTNET_NOLOGO=1 DOTNET_CLI_USE_MSBUILD_SERVER=0
export RUST_TEST_THREADS="${RUST_TEST_THREADS:-2}"

# --scope runs in the foreground (cwd, env, tty and exit code pass through) and keeps the slot fd.
# Docker containers run under dockerd, so the quota caps only the client/build side.
run=(ionice -c2 -n7 "$@")
if systemd-run --user --scope --quiet --collect -p "CPUQuota=$CPU_QUOTA" -- true >/dev/null 2>&1; then
  run=(systemd-run --user --scope --quiet --collect -p "CPUQuota=$CPU_QUOTA" -p CPUWeight=20
       -p MemoryHigh="${ALLWIN_HEAVY_MEMORY_HIGH:-8G}" --nice=10 -- "${run[@]}")
else
  echo "allwin-heavy: no usable systemd --user scope; running with nice only (no CPU quota)" >&2
  run=(nice -n 10 "${run[@]}")
fi

if [ "$FRESH" != 1 ] && [ "$SCCACHE_ON" != 1 ]; then exec "${run[@]}"; fi

# The wrapper stays alive (the slot stays held) to stop this job's sccache server and remove the fresh target.
if [ "$FRESH" = 1 ] && [ "$SLOT_TARGET" != 1 ]; then
  case "$CARGO_TARGET_DIR" in "$TARGET_ROOT"/verify-*) ;; *) echo "allwin-heavy: unexpected target dir" >&2; exit 1 ;; esac
fi
cleanup() {
  rm -f -- "$LOCK_DIR/slot.$held.info"
  if [ "$SCCACHE_ON" = 1 ]; then
    "$SCCACHE_BIN" --stop-server >/dev/null 2>&1 || true
    rm -f -- "$SCCACHE_SERVER_UDS"
  fi
  if [ "$FRESH" = 1 ] && [ "$SLOT_TARGET" != 1 ] && [ "${ALLWIN_HEAVY_KEEP_TARGET:-0}" != 1 ]; then rm -rf -- "$CARGO_TARGET_DIR"; fi
}
trap cleanup EXIT
trap 'exit 130' INT TERM
rc=0
"${run[@]}" || rc=$?
exit "$rc"
