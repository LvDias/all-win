<Project>
  <!-- Shared settings for the NinjaTrader 8 plugin projects (owner: Plugin Engineer). -->
  <PropertyGroup>
    <!-- NT8 8.1.8.4 compiles hot-loop source with Roslyn C# 13 (spike plan F2); stay at or below it. -->
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <InvariantGlobalization>true</InvariantGlobalization>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- Supply chain (QA Security L1): exact dependency graph in packages.lock.json, CI restores with
         locked mode, and every package (transitive included) is audited. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <!-- NU1900 = the vulnerability feed could not be reached. Tolerated offline on dev machines, never in CI. -->
    <NoWarn Condition="'$(CI)' != 'true'">$(NoWarn);NU1900</NoWarn>
  </PropertyGroup>
</Project>
