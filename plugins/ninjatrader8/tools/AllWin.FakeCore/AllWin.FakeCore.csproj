<Project Sdk="Microsoft.NET.Sdk.Web">
  <!--
    Scripted fake Core (spike plan §5 deliverable 3, profile §13.3): the mirror of core/tools/adapter-sim.
    Listens on loopback only. With -with-sim it also hosts the real adapter engine against the
    simulated platform, so every scenario runs on Linux without NinjaTrader.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <LangVersion>latest</LangVersion>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>AllWin.FakeCore</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\AllWin.Adapter.Core\AllWin.Adapter.Core.csproj" SetTargetFramework="TargetFramework=netstandard2.0" />
    <ProjectReference Include="..\..\src\AllWin.Adapter.Sim\AllWin.Adapter.Sim.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="scenarios\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="AllWin.Adapter.Core.Tests" />
  </ItemGroup>
</Project>
