{
  "name": "stale",
  "description": "ADR-0004 §4 bounded re-delivery: a command whose envelope sent_at is older than 6 days is rejected command.stale and never executed. NT8-compatible.",
  "requires_sim": false,
  "accounts": [{ "alias": "A", "platform_account": "Sim101" }],
  "sim": { "tick_size": { "MNQ": "0.25" }, "price": { "MNQ": "21000" } },
  "steps": [
    { "do": "wait_ready" },
    { "do": "command", "id": "X1", "kind": "flatten", "flatten": { "reason": "close" }, "sent_at_offset_ms": -604800000 },
    { "do": "expect_report", "command": "X1", "match": { "status": "rejected", "reason_code": "command.stale" } },
    { "do": "expect_no_report", "command": "X1", "match": { "child_role": "flatten", "status": "cancelled" }, "within_ms": 1000 }
  ]
}
