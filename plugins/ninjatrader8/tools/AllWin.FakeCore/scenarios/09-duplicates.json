{
  "name": "duplicates",
  "description": "ADR-0004 §4: transport duplicate (same msg_id) is only acked; business duplicate (same command_id) is answered duplicate; neither executes twice. NT8-compatible.",
  "requires_sim": false,
  "accounts": [{ "alias": "A", "platform_account": "Sim101" }],
  "sim": { "tick_size": { "MNQ": "0.25" }, "price": { "MNQ": "21000" } },
  "steps": [
    { "do": "wait_ready" },
    { "do": "command", "id": "E1", "msg": "M1", "kind": "place", "place": { "side": "buy", "quantity": 1, "order": { "type": "market" }, "position_effect": "open" } },
    { "do": "expect_report", "command": "E1", "match": { "status": "filled" } },
    { "do": "resend", "msg": "M1" },
    { "do": "expect_no_report", "command": "E1", "match": { "status": "duplicate" }, "within_ms": 1000 },
    { "do": "repeat_command", "id": "E1" },
    { "do": "expect_report", "command": "E1", "match": { "status": "duplicate", "reason_code": "command.duplicate", "child_role": "entry" } },
    { "do": "expect_report", "command": "E1", "match": { "status": "filled" }, "count": 1, "exact": true },
    { "do": "command", "id": "X1", "kind": "flatten", "flatten": { "reason": "close" } },
    { "do": "expect_report", "command": "X1", "match": { "status": "filled", "position_after": { "quantity": 0 } } }
  ]
}
