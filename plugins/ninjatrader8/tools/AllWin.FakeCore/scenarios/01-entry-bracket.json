{
  "name": "entry-bracket",
  "description": "S2 AC-2/AC-3: market entry fills, stop and target are placed from the fill price and reported. NT8-compatible.",
  "requires_sim": false,
  "accounts": [{ "alias": "A", "platform_account": "Sim101" }],
  "sim": { "tick_size": { "MNQ": "0.25" }, "price": { "MNQ": "21034.50" } },
  "steps": [
    { "do": "wait_ready" },
    { "do": "expect_snapshot", "trigger": "reconnect" },
    { "do": "command", "id": "E1", "kind": "place", "ttl_ms": 5000,
      "place": { "side": "buy", "quantity": 2, "order": { "type": "market" }, "position_effect": "open",
                 "protection": { "mode": "individual", "stop_ticks": 40, "target_ticks": 80 } } },
    { "do": "expect_report", "command": "E1", "match": { "status": "received", "child_role": "entry" } },
    { "do": "expect_report", "command": "E1", "match": { "status": "filled", "child_role": "entry", "position_after": { "quantity": 2 } } },
    { "do": "expect_report", "command": "E1", "match": { "status": "working", "child_role": "stop", "order": { "type": "stop", "time_in_force": "gtc" } } },
    { "do": "expect_report", "command": "E1", "match": { "status": "working", "child_role": "target", "order": { "type": "limit" } } },
    { "do": "command", "id": "X1", "kind": "flatten", "flatten": { "reason": "close" } },
    { "do": "expect_report", "command": "X1", "match": { "status": "filled", "child_role": "flatten", "position_after": { "quantity": 0 } } },
    { "do": "expect_report", "command": "E1", "match": { "status": "cancelled", "child_role": "stop" } },
    { "do": "expect_report", "command": "E1", "match": { "status": "cancelled", "child_role": "target" } }
  ]
}
