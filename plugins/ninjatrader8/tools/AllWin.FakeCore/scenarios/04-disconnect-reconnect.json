{
  "name": "disconnect-reconnect",
  "description": "ADR-0004 §4/§6: the Core drops the session mid-trade; the adapter reconnects, retransmits its outbox with the same msg_ids, then sends the reconnect snapshot. Commands sent before are never executed twice. NT8-compatible.",
  "requires_sim": false,
  "accounts": [{ "alias": "A", "platform_account": "Sim101" }],
  "sim": { "tick_size": { "MNQ": "0.25" }, "price": { "MNQ": "21034.50" } },
  "steps": [
    { "do": "wait_ready" },
    { "do": "drop_acks", "value": true },
    { "do": "command", "id": "E1", "msg": "M1", "kind": "place",
      "place": { "side": "buy", "quantity": 1, "order": { "type": "market" }, "position_effect": "open",
                 "protection": { "mode": "individual", "stop_ticks": 40, "target_ticks": 80 } } },
    { "do": "expect_report", "command": "E1", "match": { "status": "working", "child_role": "stop" } },
    { "do": "close", "code": 4000 },
    { "do": "drop_acks", "value": false },
    { "do": "expect_session", "count": 2 },
    { "do": "expect_snapshot", "trigger": "reconnect", "positions": { "A": { "MNQ": 1 } }, "working_orders": { "A": 2 } },
    { "do": "resend", "msg": "M1" },
    { "do": "repeat_command", "id": "E1" },
    { "do": "expect_report", "command": "E1", "match": { "status": "duplicate", "reason_code": "command.duplicate" } },
    { "do": "expect_report", "command": "E1", "match": { "status": "filled", "child_role": "entry" }, "count": 1, "exact": true },
    { "do": "command", "id": "X1", "kind": "flatten", "flatten": { "reason": "close" } },
    { "do": "expect_report", "command": "X1", "match": { "status": "filled", "position_after": { "quantity": 0 } } }
  ]
}
