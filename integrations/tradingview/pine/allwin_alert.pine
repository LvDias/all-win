// ============================================================================
// All Win — alert builder for TradingView (instruction contract v1, schema 1.0)
// Paste this whole block into the indicator, right after the indicator() line.
// Pine Script v6. Everything is prefixed aw_ to avoid name clashes.
// The webhook URL (with its secret) is set only in the TradingView alert dialog;
// it never appears in this code or in the message.
// Guide: integrations/tradingview/GUIDE.pt-BR.md / GUIDE.en.md
// ============================================================================

// ---- Inputs ----------------------------------------------------------------
AW_GRP = "All Win"
aw_src_name  = input.string("nq-es-strikes", "Source name", group = AW_GRP, tooltip = "1-24 characters A-Z a-z 0-9 . _ -. Part of every message_id: do not change it during the trading day.")
aw_src_ver   = input.string("4.0", "Indicator version", group = AW_GRP)
aw_qty_trig  = input.int(1, "Quantity: triggers", minval = 1, maxval = 1000, group = AW_GRP)
aw_qty_tp    = input.int(1, "Quantity: Trade Plan", minval = 1, maxval = 1000, group = AW_GRP)
aw_qty_nq    = input.int(1, "Quantity: NQ Triggers", minval = 1, maxval = 1000, group = AW_GRP)
aw_opposite  = input.string("do not send", "Opposite signal sends", options = ["reverse", "close", "do not send"], group = AW_GRP, tooltip = "A signal opposite to the indicator's last opening direction. reverse: flips the position. close: only flattens. do not send: written to Pine Logs only. The other signals always send buy/sell.")
aw_live      = input.bool(true, "Send alerts (off = Pine Logs only)", group = AW_GRP, tooltip = "Off: messages are only written to Pine Logs, nothing is sent to the webhook.")

// ---- Constants and state -----------------------------------------------------
// V1 trades MNQ only (QQQ/SPY are references). No contract month is sent: All Win uses the
// active contract of its catalog and rolls it on the date the admin configures.
AW_SYMBOL = "MNQ"
AW_ID_CHARS = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789._:-"
// Ids already sent during this script run. Persists across realtime ticks (varip);
// it is reset when the script reloads, and then the Core's message_id dedupe applies.
varip array<string> aw_sent = array.new<string>()
// The indicator's own view of its position PER SIGNAL TYPE: "long", "short" or "" (flat), from the opening
// signals of that type (accounts subscribe per signal type, so the types are independent). Index:
// 0 = trigger, 1 = trade_plan, 2 = nq_trigger. Historical bars rebuild it after a reload. It is not the
// account's position: All Win decides with the account's real position and refuses a conflicting buy/sell.
// An array: a function cannot reassign a global variable, but it can change an array.
varip array<string> aw_dir = array.from("", "", "")
// Opening events already decided (kind|setup|dir|bar time), so a touch signal re-evaluated on later
// ticks of the same bar is decided once.
varip array<string> aw_events = array.new<string>()

// ---- Helpers ---------------------------------------------------------------
// Keeps only characters allowed in message_id ([A-Za-z0-9._:-]).
aw_tok(string s) =>
    string out = ""
    int n = str.length(s)
    if n > 0
        for i = 0 to n - 1
            string ch = str.substring(s, i, i + 1)
            if str.contains(AW_ID_CHARS, ch)
                out := out + ch
    out

aw_pad(int v, int width) =>
    string s = str.tostring(v)
    while str.length(s) < width
        s := "0" + s
    s

// RFC 3339 UTC with milliseconds and Z suffix, e.g. 2026-10-22T14:31:05.123Z.
aw_utc(int t) =>
    aw_pad(year(t, "UTC"), 4) + "-" + aw_pad(month(t, "UTC"), 2) + "-" + aw_pad(dayofmonth(t, "UTC"), 2) + "T" + aw_pad(hour(t, "UTC"), 2) + ":" + aw_pad(minute(t, "UTC"), 2) + ":" + aw_pad(second(t, "UTC"), 2) + "." + aw_pad(t % 1000, 3) + "Z"

// JSON string escaping for free text: backslash, double quote and newline. Any other control
// character is caught by aw_send, which then sends nothing.
aw_esc(string s) =>
    str.replace_all(str.replace_all(str.replace_all(s, "\\", "\\\\"), "\"", "\\\""), "\n", "\\n")

// One "key":"value" pair for the details object. Join several with ",".
aw_kv(string key, string value) =>
    "\"" + aw_esc(key) + "\":\"" + aw_esc(value) + "\""

// Chart ticker without disallowed characters (NQ1! -> NQ1). Computed once.
var string AW_CHART = aw_tok(syminfo.ticker)

// ---- Load-time checks (the indicator shows the error before any alert exists) ----
if barstate.isfirst
    if str.match(aw_src_name, "^[A-Za-z0-9._-]{1,24}$") == ""
        runtime.error("All Win: source name must have 1-24 characters A-Z a-z 0-9 . _ -")
    if str.length(aw_src_ver) < 1 or str.length(aw_src_ver) > 32
        runtime.error("All Win: indicator version must have 1-32 characters")

// ---- Main function ---------------------------------------------------------------
// Builds the All Win instruction and calls alert() once per distinct event.
//   kind    : "trigger" | "trade_plan" | "nq_trigger"
//   timing  : "close" = sent on the bar's last tick (engulfing triggers and NQ Triggers; no repainting,
//             up to one bar of delay) | "touch" = sent intrabar as soon as the condition is true (Trade Plan
//             and triggers in touch mode; the order is sent even if the condition is gone at bar close)
//   action  : "buy" | "sell" | "close" | "reverse"
//   side    : "long" | "short" for reverse (final side); "" otherwise
//   setup   : short code that identifies the signal, part of message_id: 1-16 characters
//             A-Z a-z 0-9 . _ (e.g. "s6", "tp", "nq"); anything else is refused, never stripped
//   qty     : base quantity in contracts (ignored for close)
//   details : "" or pairs built with aw_kv(), joined with ","; hard limit 32 pairs (more = nothing sent).
//             Good practice: values deterministic for the event (no timenow, live price or counters);
//             details are not compared for duplicate conflicts.
// Returns the message_id, or "" when nothing was sent.
aw_send(string kind, string timing, string action, string side, string setup, int qty, string details) =>
    string sentId = ""
    bool kindOk = kind == "trigger" or kind == "trade_plan" or kind == "nq_trigger"
    bool timingValid = timing == "close" or timing == "touch"
    bool actionOk = action == "buy" or action == "sell" or action == "close" or (action == "reverse" and (side == "long" or side == "short"))
    bool setupOk = str.match(setup, "^[A-Za-z0-9._]{1,16}$") != ""
    bool detailsOk = details == "" or array.size(str.split(details, "\":\"")) - 1 <= 32
    bool timingOk = barstate.isrealtime and (timing == "touch" or barstate.isconfirmed)
    if not kindOk or not timingValid or not actionOk or not setupOk or not detailsOk
        log.error("All Win: invalid kind/timing/action/side/setup or more than 32 details: " + kind + " " + timing + " " + action + " " + side + " " + setup + " (nothing sent)")
    else if timingOk
        string act = action == "reverse" ? "reverse_" + side : action
        // Deterministic event key: the same event re-fired has the same id (the Core answers
        // "duplicate"); distinct sources, signals, charts and timeframes get distinct ids.
        string id = "tv-" + aw_src_name + "-" + AW_SYMBOL + "-" + kind + "-" + setup + "-" + act + "-" + AW_CHART + "-" + timeframe.period + "-" + str.tostring(time)
        string j = "{\"schema_version\":\"1.0\",\"message_id\":\"" + id + "\",\"sent_at\":\"" + aw_utc(timenow) + "\""
        j := j + ",\"source\":{\"type\":\"tradingview\",\"name\":\"" + aw_esc(aw_src_name) + "\",\"version\":\"" + aw_esc(aw_src_ver) + "\"}"
        j := j + ",\"signal_type\":\"" + kind + "\",\"action\":\"" + action + "\""
        if action == "reverse"
            j := j + ",\"side\":\"" + side + "\""
        j := j + ",\"instrument\":{\"symbol\":\"" + AW_SYMBOL + "\"}"
        if action != "close"
            j := j + ",\"quantity\":" + str.tostring(math.max(1, math.min(1000, qty)))
        if details != ""
            j := j + ",\"details\":{" + details + "}"
        j := j + "}"
        if str.length(id) > 128
            log.error("All Win: message_id longer than 128 characters (nothing sent): " + id)
        else if str.match(j, "[\\x00-\\x1F]") != ""
            log.error("All Win: control character in source or details (nothing sent)")
        else if str.contains(j, "awk_") or str.contains(j, "awd_")
            log.error("All Win: message looks like it contains a token (nothing sent)")
        else if not array.includes(aw_sent, id)
            array.push(aw_sent, id)
            if array.size(aw_sent) > 100
                array.shift(aw_sent)
            log.info(j)
            if aw_live
                alert(j, alert.freq_all)
            sentId := id
    sentId

// Opening signal: dir = "long" (Bull, buys) | "short" (Bear, sells), with the kind's base quantity.
// Same direction or flat: buy/sell. Opposite to the last opening direction OF THE SAME SIGNAL TYPE: what the
// "Opposite signal sends" input says (reverse, close, or nothing). Returns the message_id, or "".
aw_open(string kind, string timing, string dir, string setup, string details) =>
    int qty = kind == "trade_plan" ? aw_qty_tp : kind == "nq_trigger" ? aw_qty_nq : aw_qty_trig
    string sentId = ""
    int slot = kind == "trade_plan" ? 1 : kind == "nq_trigger" ? 2 : 0
    // The event counts on a historical bar (rebuilds aw_dir) or when aw_send may send it now.
    bool due = barstate.ishistory or (barstate.isrealtime and (timing == "touch" or barstate.isconfirmed))
    string key = kind + "|" + setup + "|" + dir + "|" + str.tostring(time)
    if dir != "long" and dir != "short"
        log.error("All Win: dir must be long or short: " + dir + " (nothing sent)")
    else if due and not array.includes(aw_events, key)
        array.push(aw_events, key)
        if array.size(aw_events) > 100
            array.shift(aw_events)
        string last = array.get(aw_dir, slot)
        bool opposite = last != "" and last != dir
        if not opposite
            sentId := aw_send(kind, timing, dir == "long" ? "buy" : "sell", "", setup, qty, details)
            array.set(aw_dir, slot, dir)
        else if aw_opposite == "reverse"
            sentId := aw_send(kind, timing, "reverse", dir, setup, qty, details)
            array.set(aw_dir, slot, dir)
        else if aw_opposite == "close"
            sentId := aw_send(kind, timing, "close", "", setup, 0, details)
            array.set(aw_dir, slot, "")
        else if barstate.isrealtime
            log.info("All Win: not sent (opposite signal, input 'do not send'): " + kind + " " + setup + " " + dir)
    sentId

// The indicator's own take/stop alerts: written to Pine Logs only, NEVER sent to All Win
// (stop and target come from each account's profile).
aw_note(string what, string text) =>
    log.info("All Win: not sent (" + what + "): " + text)

// ---- Usage (replace the conditions with the indicator's own) --------------------
// Triggers (Setups) by engulfing: bar close. Bull buys, Bear sells.
// if bullEngulfSetup6
//     aw_open("trigger", "close", "long", "s6", aw_kv("setup", "Setup 6") + "," + aw_kv("zone", zoneName))
// Trigger in touch mode: intrabar. Give it its own setup code, so a touch and an engulfing
// on the same bar stay two signals.
// if bearTouchSetup3
//     aw_open("trigger", "touch", "short", "s3t", "")
// Trade Plan: intrabar, in the direction of its target (target above the price = long).
// if tradePlanActivated
//     aw_open("trade_plan", "touch", tpTarget > close ? "long" : "short", "tp", "")
// NQ Trigger by engulfing: bar close.
// if nqBearEngulf
//     aw_open("nq_trigger", "close", "short", "nq", "")
// Take/stop alerts of the indicator: log only.
// if takeHit
//     aw_note("take", "Setup 6 target reached")
// ============================================================================
