{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://allwin.app/contracts/notifications/v1/params.schema.json",
  "$comment": "GENERATED by contracts/scripts/check_openapi.py --write from the HTTP bundle (NotificationParamsByCode). Do not edit.",
  "$defs": {
    "DetailsConnectionStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "connection_id",
        "connection_name",
        "status"
      ],
      "properties": {
        "connection_id": {
          "$ref": "#/$defs/Uuid"
        },
        "connection_name": {
          "type": "string",
          "maxLength": 60
        },
        "previous_status": {
          "type": "string",
          "enum": [
            "awaiting_pairing",
            "connected",
            "disconnected",
            "outdated",
            "unpaired"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "awaiting_pairing",
            "connected",
            "disconnected",
            "outdated",
            "unpaired"
          ]
        }
      }
    },
    "DetailsEvaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profit_target",
        "achieved",
        "start"
      ],
      "description": "`risk.evaluation_target_reached` (notify only, Q70).",
      "properties": {
        "start": {
          "type": "string",
          "format": "date"
        },
        "previous_start": {
          "type": "string",
          "format": "date"
        },
        "earned_before": {
          "$ref": "#/$defs/Money"
        },
        "previous_earned_before": {
          "$ref": "#/$defs/Money"
        },
        "profit_target": {
          "$ref": "#/$defs/Money"
        },
        "achieved": {
          "$ref": "#/$defs/Money"
        }
      }
    },
    "DetailsRiskState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "limit",
        "used",
        "percent"
      ],
      "description": "`risk.warning`, `risk.limit_reached`, `risk.target_reached` (+ `action`), `risk.consistency_warning`.",
      "properties": {
        "kind": {
          "$ref": "#/$defs/RiskRuleKind"
        },
        "limit": {
          "type": "string",
          "pattern": "^-?[0-9]{1,14}(\\.[0-9]{1,4})?$",
          "description": "Money, or a percent string for consistency."
        },
        "used": {
          "type": "string",
          "pattern": "^-?[0-9]{1,14}(\\.[0-9]{1,4})?$",
          "description": "Money, or a percent string for consistency."
        },
        "percent": {
          "type": "integer",
          "minimum": 0
        },
        "action": {
          "type": "string",
          "enum": [
            "notify",
            "flatten_and_block"
          ]
        }
      }
    },
    "DetailsRoutingDecision": {
      "type": "object",
      "additionalProperties": false,
      "description": "Every `routing.*` decision code (routed, capped, skipped, refused, expired). Q74: for a `reverse`\nthe position check (ADR-0003 §4.2) runs before the entry gates. On an account barred for entries\n(`out_of_sync`, `risk_blocked`, `limits_pending`, `no_bracket_profile`), or with no room\n(`max_position_reached`, derived M = 0): position opposite → only the close leg runs, and the\nentry carries the gate code, outcome `partial` (decision `capped`), `sizing.executed_qty` = 0\nfor the open, and `reverse_closed_qty`; flat → skipped with the gate code, no\n`reverse_closed_qty`; already on the reverse side → `routing.position_conflict` (rejected and\nnotified, never a flatten).\n",
      "properties": {
        "sizing": {
          "$ref": "#/$defs/DetailsSizing"
        },
        "lifecycle_state": {
          "type": "string",
          "enum": [
            "paused",
            "disabled"
          ]
        },
        "opt_in_state": {
          "type": "string",
          "enum": [
            "declined",
            "pending_review"
          ]
        },
        "rule_version_id": {
          "$ref": "#/$defs/Uuid"
        },
        "sync_reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^sync\\.[a-z][a-z0-9_]*$"
          }
        },
        "position_side": {
          "type": "string",
          "enum": [
            "long",
            "short",
            "flat"
          ]
        },
        "account_size": {
          "$ref": "#/$defs/SizeAmount"
        },
        "instrument_ids": {
          "description": "With `routing.no_bracket_profile`.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Uuid"
          }
        },
        "limits_version": {
          "type": "integer",
          "minimum": 1,
          "description": "With `routing.limits_pending` — the account's limits version not yet derived (ADR-0006)."
        },
        "reverse_closed_qty": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000,
          "description": "Q74: contracts flattened by the close leg of a reverse whose open leg was skipped with this code."
        },
        "ttl_ms": {
          "type": "integer",
          "minimum": 1
        },
        "expiry_base": {
          "$ref": "#/$defs/Timestamp"
        }
      }
    },
    "DetailsSizing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "multiplier",
        "max_position_qty"
      ],
      "properties": {
        "instruction_qty": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "multiplier": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "requested_qty": {
          "type": "integer",
          "minimum": 0,
          "description": "instruction quantity × multiplier."
        },
        "max_position_qty": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "position_before": {
          "type": "integer",
          "description": "Signed, the Core's expected position."
        },
        "executed_qty": {
          "type": "integer",
          "minimum": 0,
          "description": "After the cap."
        },
        "skipped_qty": {
          "type": "integer",
          "minimum": 0,
          "description": "requested − executed."
        }
      }
    },
    "Money": {
      "type": "string",
      "pattern": "^-?[0-9]{1,14}(\\.[0-9]{1,4})?$",
      "description": "Money as a decimal string (NUMERIC(18,4))."
    },
    "OptInKind": {
      "type": "string",
      "enum": [
        "automation",
        "copy"
      ]
    },
    "ParamsOptInSuspendedByFirm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "firm_id",
        "firm_name",
        "account_count",
        "rule_version_id"
      ],
      "description": "`accounts.opt_in_suspended` grouped per firm and release (one notification, \"{k} contas\"); the audit keeps one entry per account.",
      "properties": {
        "kind": {
          "$ref": "#/$defs/OptInKind"
        },
        "firm_id": {
          "$ref": "#/$defs/Uuid"
        },
        "firm_name": {
          "type": "string",
          "maxLength": 120
        },
        "account_count": {
          "type": "integer",
          "minimum": 1
        },
        "rule_version_id": {
          "$ref": "#/$defs/Uuid"
        },
        "cause": {
          "type": "string",
          "enum": [
            "stance_changed",
            "text_changed",
            "preset_attached"
          ]
        }
      }
    },
    "ParamsPresetNewVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "firm_id",
        "firm_name",
        "version_number",
        "account_count"
      ],
      "description": "`presets.new_version` — one per firm (Q-S16-5): a newer release affects `account_count` of the caller's accounts.",
      "properties": {
        "firm_id": {
          "$ref": "#/$defs/Uuid"
        },
        "firm_name": {
          "type": "string",
          "maxLength": 120
        },
        "version_number": {
          "type": "integer",
          "minimum": 1
        },
        "account_count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "ParamsReverseCloseOnly": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reason_code",
        "closed_qty",
        "closed_side"
      ],
      "description": "Q74 (Vigia I1): a `reverse` that closed the position and skipped the open, because the account is\nbarred for entries or has no room. Always notified, one per occurrence, whatever the gate\n(including `routing.limits_pending`, which is otherwise not notified). It replaces the gate's own\ngrouped notification for that occurrence. The audit entry carries the gate code\n(`DetailsRoutingDecision.reverse_closed_qty`).\n",
      "properties": {
        "reason_code": {
          "type": "string",
          "enum": [
            "routing.out_of_sync",
            "routing.risk_blocked",
            "routing.limits_pending",
            "routing.no_bracket_profile",
            "routing.max_position_reached"
          ]
        },
        "closed_qty": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "closed_side": {
          "type": "string",
          "enum": [
            "long",
            "short"
          ],
          "description": "The side of the position that was closed."
        }
      }
    },
    "RiskRuleKind": {
      "type": "string",
      "enum": [
        "daily_loss",
        "drawdown",
        "daily_profit_target",
        "consistency"
      ]
    },
    "SizeAmount": {
      "type": "string",
      "description": "Account size in `currency` (decimal string, at most 2 decimals, > 0). Zero fails the pattern: 400 `common.invalid_request`.",
      "pattern": "^([1-9][0-9]{0,11}(\\.[0-9]{1,2})?|0\\.([1-9][0-9]?|0[1-9]))$"
    },
    "Timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
    },
    "Uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    }
  }
}
