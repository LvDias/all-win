{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://allwin.app/contracts/notifications/v1/params.schema.json",
  "$comment": "GENERATED by contracts/scripts/check_openapi.py --write from the HTTP bundle (NotificationParamsByCode). Do not edit.",
  "$defs": {
    "DetailsConnectionStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "connection_id",
        "connection_name",
        "status"
      ],
      "properties": {
        "connection_id": {
          "$ref": "#/$defs/Uuid"
        },
        "connection_name": {
          "type": "string",
          "maxLength": 60
        },
        "previous_status": {
          "type": "string",
          "enum": [
            "awaiting_pairing",
            "connected",
            "disconnected",
            "outdated",
            "unpaired"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "awaiting_pairing",
            "connected",
            "disconnected",
            "outdated",
            "unpaired"
          ]
        }
      }
    },
    "DetailsRiskState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "limit",
        "used",
        "percent"
      ],
      "description": "`risk.warning`, `risk.limit_reached`, `risk.target_reached` (+ `action`), `risk.consistency_warning`.",
      "properties": {
        "kind": {
          "$ref": "#/$defs/RiskRuleKind"
        },
        "limit": {
          "type": "string",
          "pattern": "^-?[0-9]{1,14}(\\.[0-9]{1,4})?$",
          "description": "Money, or a percent string for consistency."
        },
        "used": {
          "type": "string",
          "pattern": "^-?[0-9]{1,14}(\\.[0-9]{1,4})?$",
          "description": "Money, or a percent string for consistency."
        },
        "percent": {
          "type": "integer",
          "minimum": 0
        },
        "action": {
          "type": "string",
          "enum": [
            "notify",
            "flatten_and_block"
          ]
        }
      }
    },
    "DetailsRoutingDecision": {
      "type": "object",
      "additionalProperties": false,
      "description": "Every `routing.*` decision code (routed, capped, skipped, refused, expired).",
      "properties": {
        "sizing": {
          "$ref": "#/$defs/DetailsSizing"
        },
        "lifecycle_state": {
          "type": "string",
          "enum": [
            "paused",
            "disabled"
          ]
        },
        "opt_in_state": {
          "type": "string",
          "enum": [
            "declined",
            "pending_review"
          ]
        },
        "rule_version_id": {
          "$ref": "#/$defs/Uuid"
        },
        "sync_reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^sync\\.[a-z][a-z0-9_]*$"
          }
        },
        "position_side": {
          "type": "string",
          "enum": [
            "long",
            "short",
            "flat"
          ]
        },
        "account_size": {
          "$ref": "#/$defs/SizeAmount"
        },
        "instrument_ids": {
          "description": "With `routing.no_bracket_profile`.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Uuid"
          }
        },
        "limits_version": {
          "type": "integer",
          "minimum": 1,
          "description": "With `routing.limits_pending` — the account's limits version not yet derived (ADR-0006)."
        },
        "ttl_ms": {
          "type": "integer",
          "minimum": 1
        },
        "expiry_base": {
          "$ref": "#/$defs/Timestamp"
        }
      }
    },
    "DetailsSizing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "multiplier",
        "max_position_qty"
      ],
      "properties": {
        "instruction_qty": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "multiplier": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "requested_qty": {
          "type": "integer",
          "minimum": 0,
          "description": "instruction quantity × multiplier."
        },
        "max_position_qty": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "position_before": {
          "type": "integer",
          "description": "Signed, the Core's expected position."
        },
        "executed_qty": {
          "type": "integer",
          "minimum": 0,
          "description": "After the cap."
        },
        "skipped_qty": {
          "type": "integer",
          "minimum": 0,
          "description": "requested − executed."
        }
      }
    },
    "OptInKind": {
      "type": "string",
      "enum": [
        "automation",
        "copy"
      ]
    },
    "ParamsOptInSuspendedByFirm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "firm_id",
        "firm_name",
        "account_count",
        "rule_version_id"
      ],
      "description": "`accounts.opt_in_suspended` grouped per firm and release (one notification, \"{k} contas\"); the audit keeps one entry per account.",
      "properties": {
        "kind": {
          "$ref": "#/$defs/OptInKind"
        },
        "firm_id": {
          "$ref": "#/$defs/Uuid"
        },
        "firm_name": {
          "type": "string",
          "maxLength": 120
        },
        "account_count": {
          "type": "integer",
          "minimum": 1
        },
        "rule_version_id": {
          "$ref": "#/$defs/Uuid"
        },
        "cause": {
          "type": "string",
          "enum": [
            "stance_changed",
            "text_changed",
            "preset_attached"
          ]
        }
      }
    },
    "ParamsPresetNewVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "firm_id",
        "firm_name",
        "version_number",
        "account_count"
      ],
      "description": "`presets.new_version` — one per firm (Q-S16-5): a newer release affects `account_count` of the caller's accounts.",
      "properties": {
        "firm_id": {
          "$ref": "#/$defs/Uuid"
        },
        "firm_name": {
          "type": "string",
          "maxLength": 120
        },
        "version_number": {
          "type": "integer",
          "minimum": 1
        },
        "account_count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "RiskRuleKind": {
      "type": "string",
      "enum": [
        "daily_loss",
        "drawdown",
        "daily_profit_target",
        "consistency"
      ]
    },
    "SizeAmount": {
      "type": "string",
      "description": "Account size in `currency` (decimal string, at most 2 decimals, > 0). Zero fails the pattern: 400 `common.invalid_request`.",
      "pattern": "^([1-9][0-9]{0,11}(\\.[0-9]{1,2})?|0\\.([1-9][0-9]?|0[1-9]))$"
    },
    "Timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?Z$"
    },
    "Uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    }
  }
}
