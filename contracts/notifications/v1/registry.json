{
  "$comment": "Notification registry v1 (V1-S18). Single source of codes for the Web (HTTP modules/notifications.yaml) and the plugin (adapter protocol 1.3). Owner: Software Architect (Compasso). params names a $defs entry of params.schema.json, which check_openapi.py generates from the HTTP bundle (NotificationParamsByCode). Texts live in each client's pt-BR/en catalog; drift test: every code has a key in both languages in both clients.",
  "version": "1.0.0",
  "params_schema": "params.schema.json",
  "severities": ["info", "success", "warning", "danger", "critical"],
  "groupings": {
    "none": "every occurrence is its own notification",
    "account_trading_day": "same code + account + trading day collapse into one item (count, last time); only the first occurrence is unread",
    "firm_release": "one item per firm and release, with account_count"
  },
  "codes": {
    "routing.quantity_capped":      { "category": "routing", "severity": "warning", "grouping": "account_trading_day", "target": "instruction", "params": "DetailsRoutingDecision" },
    "routing.max_position_reached": { "category": "routing", "severity": "warning", "grouping": "account_trading_day", "target": "instruction", "params": "DetailsRoutingDecision" },
    "routing.position_conflict":    { "category": "routing", "severity": "warning", "grouping": "account_trading_day", "target": "instruction", "params": "DetailsRoutingDecision" },
    "routing.risk_blocked":         { "category": "routing", "severity": "danger",  "grouping": "account_trading_day", "target": "account",     "params": "DetailsRoutingDecision" },
    "routing.out_of_sync":          { "category": "routing", "severity": "danger",  "grouping": "account_trading_day", "target": "account",     "params": "DetailsRoutingDecision" },
    "routing.expired":              { "category": "routing", "severity": "danger",  "grouping": "account_trading_day", "target": "instruction", "params": "DetailsRoutingDecision" },
    "routing.no_bracket_profile":   { "category": "routing", "severity": "warning", "grouping": "account_trading_day", "target": "account",     "params": "DetailsRoutingDecision", "provisional": "Q50" },
    "risk.warning":                 { "category": "risk",    "severity": "warning", "grouping": "none", "target": "account", "params": "DetailsRiskState", "rule": "one per state change (normal → warning)" },
    "risk.limit_reached":           { "category": "risk",    "severity": "danger",  "grouping": "none", "target": "account", "params": "DetailsRiskState", "rule": "one per state change" },
    "risk.target_reached":          { "category": "risk",    "severity": "success", "grouping": "none", "target": "account", "params": "DetailsRiskState", "rule": "once per trading day (S13 AC-5)" },
    "risk.consistency_warning":     { "category": "risk",    "severity": "warning", "grouping": "none", "target": "account", "params": "DetailsRiskState", "rule": "one per state change" },
    "connection.status_changed":    { "category": "connection", "severity_by_params": { "field": "status", "values": { "disconnected": "danger", "outdated": "warning" } }, "grouping": "none", "target": "connection", "params": "DetailsConnectionStatus", "rule": "only for the statuses listed in severity_by_params" },
    "accounts.opt_in_suspended":    { "category": "config",  "severity": "warning", "grouping": "firm_release", "params": "ParamsOptInSuspendedByFirm" },
    "presets.new_version":          { "category": "config",  "severity": "info",    "grouping": "firm_release", "params": "ParamsPresetNewVersion" }
  }
}
